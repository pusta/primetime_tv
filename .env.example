# Copy to .env and edit. docker compose reads .env automatically.

# Port on this machine for the PrimeTime web UI and API.
PRIMETIME_HTTP_PORT=8080

# Time zone for logs (and, later, for channel schedules).
TZ=UTC

# Trace, Debug, Information, Warning or Error.
PRIMETIME_LOG_LEVEL=Information

# If a reverse proxy adds HTTPS in front of PrimeTime, its IP address or CIDR range,
# for example 172.18.0.0/16. Leave empty when there's no proxy.
PRIMETIME_TRUSTED_PROXIES=
